# 실제 값은 .env에 저장하고 커밋하지 않는다 (README 11장 참고)

# gpt-5-mini 답변 생성(src/generation), text-embedding-3-small 비교 실험(src/retrieval/embeddings)에 필요
OPENAI_API_KEY=

# (선택) 스캔 PDF OCR 시 tesseract 실행 파일 경로를 직접 지정해야 하는 경우에만 설정
# TESSERACT_CMD=

# 생성 모델 선택(run_integrated_model.py의 --provider 인자로 지정)
# 로컬 vLLM 기본값: http://127.0.0.1:8001/v1, Qwen/Qwen3-8B-AWQ
# 로컬 Ollama 기본값: http://127.0.0.1:11434/v1, qwen3:8b
# RAG_GENERATION_PROVIDER=vllm

# OCR backend: tesseract(기본) 또는 paddle
# Paddle 사용 시 검증·다운로드를 끝낸 로컬 모델 폴더를 반드시 지정한다.
# RAG_OCR_BACKEND=paddle
# PADDLE_OCR_DET_MODEL_DIR=/absolute/path/PP-OCRv5_server_det_infer
# PADDLE_OCR_REC_MODEL_DIR=/absolute/path/korean_PP-OCRv5_mobile_rec_infer
