# Copy to .env and fill locally. Never commit real values.
OPENAI_API_KEY=
# Optional personal-account alias used by the Streamlit application only when
# OPENAI_API_KEY is empty. Export path overrides before starting Streamlit.
OPENAI_API_KEY_PRIVATE=
MIDPROJECTRAG_DATA_DIR=./data/private
MIDPROJECTRAG_ARTIFACT_DIR=./artifacts
MIDPROJECTRAG_STACK=disabled
MIDPROJECTRAG_MAX_API_BUDGET_USD=20
