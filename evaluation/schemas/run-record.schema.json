{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midprojectrag.local/schemas/run-record.schema.json",
  "title": "MidProjectRAG private evaluation run record",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "stack_id",
    "corpus_manifest_sha256",
    "eval_set_sha256",
    "config_sha256",
    "git_commit",
    "generator_model",
    "embedding_model",
    "environment",
    "retrieval",
    "response",
    "timing_ms",
    "usage",
    "judgment",
    "seed",
    "temperature",
    "cache_hit"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^(dev|heldout)-(single|multi|followup|unknown)-[0-9]{3}$"
    },
    "stack_id": {"enum": ["api", "gcp_local"]},
    "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "eval_set_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "git_commit": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        {"const": "uncommitted"}
      ]
    },
    "generator_model": {"type": "string", "minLength": 1, "maxLength": 256},
    "embedding_model": {"type": "string", "minLength": 1, "maxLength": 256},
    "environment": {"$ref": "#/$defs/environment"},
    "retrieval": {
      "type": "array",
      "items": {"$ref": "#/$defs/retrievalHit"}
    },
    "response": {"$ref": "https://midprojectrag.local/schemas/rag-response.schema.json"},
    "timing_ms": {"$ref": "#/$defs/timing"},
    "usage": {"$ref": "#/$defs/usage"},
    "judgment": {"$ref": "#/$defs/judgment"},
    "seed": {"type": ["integer", "null"]},
    "temperature": {"type": "number", "minimum": 0},
    "cache_hit": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documentId": {"type": "string", "pattern": "^doc_[0-9a-f]{24}$"},
    "blockId": {"type": "string", "pattern": "^block_[0-9a-f]{24}$"},
    "retrievalHit": {
      "type": "object",
      "required": ["rank", "doc_id", "chunk_id", "source_block_ids", "score"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "doc_id": {"$ref": "#/$defs/documentId"},
        "chunk_id": {
          "type": "string",
          "pattern": "^chunk_[0-9a-f]{24}$"
        },
        "source_block_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/blockId"},
          "uniqueItems": true
        },
        "score": {"type": "number"}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "python_version",
        "platform",
        "vcpu",
        "ram_gb",
        "gpu_model",
        "disk_gb",
        "dependency_lock_sha256"
      ],
      "properties": {
        "python_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "platform": {"type": "string", "minLength": 1, "maxLength": 256},
        "vcpu": {"type": "integer", "minimum": 1},
        "ram_gb": {"type": "number", "exclusiveMinimum": 0},
        "gpu_model": {"type": ["string", "null"], "maxLength": 256},
        "disk_gb": {"type": "number", "exclusiveMinimum": 0},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": ["total"],
      "properties": {
        "retrieval": {"type": ["number", "null"], "minimum": 0},
        "generation": {"type": ["number", "null"], "minimum": 0},
        "total": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "embedding_tokens",
        "cost_usd",
        "gpu_seconds",
        "peak_vram_gb"
      ],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "embedding_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "gpu_seconds": {"type": ["number", "null"], "minimum": 0},
        "peak_vram_gb": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "judgment": {
      "type": "object",
      "required": [
        "matched_key_point_ids",
        "correctness",
        "faithfulness",
        "factual_claim_coverage",
        "citation_validity",
        "follow_up_success",
        "safe_abstention",
        "reviewer_ids"
      ],
      "properties": {
        "matched_key_point_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^kp_[A-Za-z0-9._:-]{1,64}$"
          },
          "uniqueItems": true
        },
        "correctness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "faithfulness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "factual_claim_coverage": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "citation_validity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "follow_up_success": {"type": ["boolean", "null"]},
        "safe_abstention": {"type": ["boolean", "null"]},
        "reviewer_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"stack_id": {"const": "api"}}},
      "then": {
        "properties": {
          "generator_model": {"enum": ["gpt-5-mini", "gpt-5-nano"]},
          "embedding_model": {"const": "text-embedding-3-small"}
        }
      }
    },
    {
      "if": {"properties": {"stack_id": {"const": "gcp_local"}}},
      "then": {
        "properties": {
          "environment": {
            "properties": {
              "vcpu": {"maximum": 4},
              "ram_gb": {"maximum": 16},
              "gpu_model": {"type": "string", "pattern": "L4"},
              "disk_gb": {"maximum": 100}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
