{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midprojectrag.local/schemas/run-record.schema.json",
  "title": "MidProjectRAG private evaluation run record",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "stack_id",
    "corpus_manifest_sha256",
    "eval_set_sha256",
    "config_sha256",
    "git_commit",
    "generator_model",
    "embedding_model",
    "environment",
    "retrieval",
    "response",
    "timing_ms",
    "usage",
    "judgment",
    "seed",
    "temperature",
    "cache_hit"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^(dev|heldout)-(single|multi|followup|unknown)-[0-9]{3}$"
    },
    "stack_id": {"enum": ["api", "gcp_local"]},
    "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "eval_set_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "git_commit": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        {"const": "uncommitted"}
      ]
    },
    "generator_model": {"type": "string", "minLength": 1, "maxLength": 256},
    "embedding_model": {"type": "string", "minLength": 1, "maxLength": 256},
    "api_profile": {"enum": ["assignment", "personal_experimental"]},
    "embedding_dimensions": {"type": "integer", "minimum": 1},
    "index_config_sha256": {"$ref": "#/$defs/sha256"},
    "embedding_model_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generator_model_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runtime": {"type": "string", "minLength": 1, "maxLength": 64},
    "runtime_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "quantization": {"type": "string", "minLength": 1, "maxLength": 64},
    "reasoning_effort": {"const": "minimal"},
    "environment": {"$ref": "#/$defs/environment"},
    "retrieval": {
      "type": "array",
      "items": {"$ref": "#/$defs/retrievalHit"}
    },
    "response": {"$ref": "https://midprojectrag.local/schemas/rag-response.schema.json"},
    "timing_ms": {"$ref": "#/$defs/timing"},
    "usage": {"$ref": "#/$defs/usage"},
    "judgment": {"$ref": "#/$defs/judgment"},
    "seed": {"type": ["integer", "null"]},
    "temperature": {"type": ["number", "null"], "minimum": 0},
    "cache_hit": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documentId": {"type": "string", "pattern": "^doc_[0-9a-f]{24}$"},
    "blockId": {"type": "string", "pattern": "^block_[0-9a-f]{24}$"},
    "retrievalHit": {
      "oneOf": [
        {"$ref": "#/$defs/textRetrievalHit"},
        {"$ref": "#/$defs/visualRetrievalHit"}
      ]
    },
    "textRetrievalHit": {
      "type": "object",
      "required": ["rank", "doc_id", "chunk_id", "source_block_ids", "score"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "doc_id": {"$ref": "#/$defs/documentId"},
        "chunk_id": {
          "type": "string",
          "pattern": "^chunk_[0-9a-f]{24}$"
        },
        "source_block_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/blockId"},
          "uniqueItems": true
        },
        "score": {"type": "number"},
        "lane": {"type": "string", "minLength": 1, "maxLength": 64},
        "lane_rank": {"type": "integer", "minimum": 1},
        "dense_score": {"type": "number"}
      },
      "dependentRequired": {
        "lane": ["lane_rank", "dense_score"],
        "lane_rank": ["lane", "dense_score"],
        "dense_score": ["lane", "lane_rank"]
      },
      "additionalProperties": false
    },
    "visualRetrievalHit": {
      "type": "object",
      "required": [
        "rank",
        "doc_id",
        "chunk_id",
        "score",
        "occurrence_id",
        "evidence_ids",
        "evidence_type",
        "page",
        "bbox",
        "crop_sha256"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "doc_id": {"$ref": "#/$defs/documentId"},
        "chunk_id": {"type": "string", "pattern": "^vchunk_[0-9a-f]{24}$"},
        "score": {"type": "number"},
        "occurrence_id": {"type": "string", "pattern": "^vocc2_[0-9a-f]{24}$"},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(?:ocr|cap)_[0-9a-f]{24}$"},
          "uniqueItems": true
        },
        "evidence_type": {"enum": ["ocr", "layout", "caption"]},
        "page": {"type": "integer", "minimum": 1},
        "bbox": {
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "w": {"type": "number", "exclusiveMinimum": 0},
            "h": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        },
        "crop_sha256": {"$ref": "#/$defs/sha256"},
        "lane": {"type": "string", "minLength": 1, "maxLength": 64},
        "lane_rank": {"type": "integer", "minimum": 1},
        "dense_score": {"type": "number"}
      },
      "dependentRequired": {
        "lane": ["lane_rank", "dense_score"],
        "lane_rank": ["lane", "dense_score"],
        "dense_score": ["lane", "lane_rank"]
      },
      "allOf": [
        {
          "if": {
            "properties": {"evidence_type": {"const": "caption"}},
            "required": ["evidence_type"]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "items": {"type": "string", "pattern": "^cap_[0-9a-f]{24}$"}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"evidence_type": {"enum": ["ocr", "layout"]}},
            "required": ["evidence_type"]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "items": {"type": "string", "pattern": "^ocr_[0-9a-f]{24}$"}
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "python_version",
        "platform",
        "region",
        "machine_type",
        "vcpu",
        "ram_gb",
        "gpu_model",
        "disk_gb",
        "dependency_lock_sha256"
      ],
      "properties": {
        "python_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "platform": {"type": "string", "minLength": 1, "maxLength": 256},
        "region": {"type": "string", "minLength": 1, "maxLength": 64},
        "machine_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "vcpu": {"type": "integer", "minimum": 1},
        "ram_gb": {"type": "number", "exclusiveMinimum": 0},
        "gpu_model": {"type": ["string", "null"], "maxLength": 256},
        "disk_gb": {"type": "number", "exclusiveMinimum": 0},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": ["total"],
      "properties": {
        "retrieval": {"type": ["number", "null"], "minimum": 0},
        "generation": {"type": ["number", "null"], "minimum": 0},
        "total": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "embedding_tokens",
        "cost_usd",
        "gpu_seconds",
        "peak_vram_gb"
      ],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "embedding_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "gpu_seconds": {"type": ["number", "null"], "minimum": 0},
        "peak_vram_gb": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "judgment": {
      "type": "object",
      "required": [
        "matched_key_point_ids",
        "correctness",
        "faithfulness",
        "factual_claim_coverage",
        "citation_validity",
        "follow_up_success",
        "safe_abstention",
        "reviewer_ids"
      ],
      "properties": {
        "matched_key_point_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^kp_[A-Za-z0-9._:-]{1,64}$"
          },
          "uniqueItems": true
        },
        "correctness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "faithfulness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "factual_claim_coverage": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "citation_validity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "follow_up_success": {"type": ["boolean", "null"]},
        "safe_abstention": {"type": ["boolean", "null"]},
        "reviewer_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"stack_id": {"const": "api"}}},
      "then": {
        "required": ["reasoning_effort"],
        "properties": {
          "generator_model": {"enum": ["gpt-5-mini", "gpt-5-nano"]},
          "reasoning_effort": {"const": "minimal"}
        }
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"stack_id": {"const": "api"}}},
          {
            "anyOf": [
              {"not": {"required": ["api_profile"]}},
              {"properties": {"api_profile": {"const": "assignment"}}}
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "embedding_model": {"const": "text-embedding-3-small"},
          "embedding_dimensions": {"const": 1536}
        }
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"stack_id": {"const": "api"}}},
          {"properties": {"api_profile": {"const": "personal_experimental"}}, "required": ["api_profile"]}
        ]
      },
      "then": {
        "required": ["embedding_dimensions", "index_config_sha256"],
        "properties": {
          "embedding_model": {
            "enum": ["text-embedding-3-small", "text-embedding-3-large"]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"embedding_model": {"const": "text-embedding-3-small"}}},
            "then": {"properties": {"embedding_dimensions": {"const": 1536}}}
          },
          {
            "if": {"properties": {"embedding_model": {"const": "text-embedding-3-large"}}},
            "then": {"properties": {"embedding_dimensions": {"const": 3072}}}
          }
        ]
      }
    },
    {
      "if": {"properties": {"stack_id": {"const": "gcp_local"}}},
      "then": {
        "required": [
          "embedding_dimensions",
          "index_config_sha256",
          "embedding_model_revision",
          "generator_model_revision",
          "runtime",
          "runtime_version",
          "quantization"
        ],
        "not": {
          "anyOf": [
            {"required": ["api_profile"]},
            {"required": ["reasoning_effort"]}
          ]
        },
        "properties": {
          "generator_model": {"const": "Qwen/Qwen3-8B-AWQ"},
          "embedding_model": {"const": "nlpai-lab/KURE-v1"},
          "embedding_dimensions": {"const": 1024},
          "embedding_model_revision": {
            "const": "4ed4540949c70b7da2c74004a915e1f2d5e46e4f"
          },
          "generator_model_revision": {
            "const": "4da05a8edb55c6046cce958586c33b61da07bb79"
          },
          "runtime": {"const": "vllm"},
          "runtime_version": {"const": "0.8.5.post1"},
          "quantization": {"const": "awq-int4"},
          "usage": {
            "properties": {
              "cost_usd": {"const": null},
              "gpu_seconds": {"type": "number", "minimum": 0},
              "peak_vram_gb": {"type": "number", "minimum": 0}
            }
          },
          "environment": {
            "properties": {
              "region": {"const": "us-central1"},
              "machine_type": {"const": "g2-standard-4"},
              "vcpu": {"const": 4},
              "ram_gb": {"const": 16},
              "gpu_model": {"type": "string", "pattern": "L4"},
              "disk_gb": {"maximum": 100}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
