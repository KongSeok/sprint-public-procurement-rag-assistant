{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midprojectrag.local/schemas/supplemental-answer-run.schema.json",
  "title": "MidProjectRAG supplemental answer baseline run",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "eval_set_sha256",
    "config_sha256",
    "status",
    "answer",
    "retrieved_doc_ids",
    "cited_doc_ids",
    "timing_ms",
    "usage",
    "cache_hit",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^supplemental-(qa|alignment)-[A-Za-z0-9._:-]+$"},
    "eval_set_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["answered", "abstained", "error"]},
    "answer": {"type": "string", "maxLength": 30000},
    "retrieved_doc_ids": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/docId"}
    },
    "cited_doc_ids": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/docId"},
      "uniqueItems": true
    },
    "timing_ms": {
      "type": "object",
      "required": ["retrieval", "generation", "total"],
      "properties": {
        "retrieval": {"type": "number", "minimum": 0},
        "generation": {"type": "number", "minimum": 0},
        "total": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["embedding_tokens", "input_tokens", "output_tokens", "cost_usd"],
      "properties": {
        "embedding_tokens": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "cache_hit": {"type": "boolean"},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code"],
          "properties": {"code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"}},
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "answered"}}, "required": ["status"]},
      "then": {
        "properties": {
          "answer": {"type": "string", "minLength": 1, "maxLength": 30000, "pattern": ".*\\S.*"},
          "error": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "abstained"}}, "required": ["status"]},
      "then": {"properties": {"answer": {"const": ""}, "error": {"const": null}}}
    },
    {
      "if": {"properties": {"status": {"const": "error"}}, "required": ["status"]},
      "then": {
        "properties": {
          "answer": {"const": ""},
          "error": {"type": "object"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "docId": {"type": "string", "pattern": "^doc_[0-9a-f]{24}$"}
  },
  "additionalProperties": false
}
