{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midprojectrag.local/schemas/ocr-evidence-v1.schema.json",
  "title": "Local OCR and layout evidence",
  "type": "object",
  "required": ["schema_version", "evidence_id", "occurrence_id", "crop_sha256", "status", "text_items", "table_cells", "model", "config_sha256", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "pattern": "^ocr_[0-9a-f]{24}$"},
    "occurrence_id": {"type": "string", "pattern": "^vocc2_[0-9a-f]{24}$"},
    "crop_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["success", "low_confidence", "failed"]},
    "text_items": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/textItem"}},
    "table_cells": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/tableCell"}},
    "model": {"$ref": "#/$defs/model"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
    "polygon": {"type": "array", "minItems": 4, "maxItems": 64, "items": {"$ref": "#/$defs/point"}},
    "textItem": {
      "type": "object", "required": ["item_id", "polygon", "text", "confidence", "reading_order"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^ocri_[0-9a-f]{24}$"},
        "polygon": {"$ref": "#/$defs/polygon"},
        "text": {"type": "string", "minLength": 1, "maxLength": 10000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reading_order": {"type": "integer", "minimum": 0}
      }, "additionalProperties": false
    },
    "tableCell": {
      "type": "object", "required": ["row", "column", "row_span", "column_span", "polygon", "text", "confidence", "source_item_ids"],
      "properties": {
        "row": {"type": "integer", "minimum": 0}, "column": {"type": "integer", "minimum": 0},
        "row_span": {"type": "integer", "minimum": 1}, "column_span": {"type": "integer", "minimum": 1},
        "polygon": {"$ref": "#/$defs/polygon"}, "text": {"type": "string", "maxLength": 10000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ocri_[0-9a-f]{24}$"}}
      }, "additionalProperties": false
    },
    "model": {
      "type": "object", "required": ["name", "version", "weights_sha256", "runtime", "device", "language"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "weights_sha256": {"$ref": "#/$defs/sha256"}, "runtime": {"type": "string", "minLength": 1},
        "device": {"type": "string", "minLength": 1}, "language": {"const": "korean"}
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
