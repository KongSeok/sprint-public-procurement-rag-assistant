{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midprojectrag.local/schemas/ordered-visual-occurrence.schema.json",
  "title": "Top-level ordered HWP visual occurrence",
  "type": "object",
  "required": [
    "schema_version", "ordered_occurrence_id", "doc_id", "page",
    "sequence_in_page", "node_type", "status", "bbox", "coordinate_space",
    "render_key", "text", "linked_block_id", "linked_image_occurrence_id",
    "preceding_text", "link_method"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "ordered_occurrence_id": {"type": "string", "pattern": "^vocc_[0-9a-f]{24}$"},
    "doc_id": {"type": "string", "pattern": "^doc_[0-9a-f]{24}$"},
    "page": {"type": "integer", "minimum": 1},
    "sequence_in_page": {"type": "integer", "minimum": 0},
    "node_type": {"enum": ["text", "table", "image"]},
    "status": {
      "enum": [
        "render_text", "verified_table_link", "verified_image_link",
        "render_only_unlinked"
      ]
    },
    "bbox": {"$ref": "#/$defs/bbox"},
    "coordinate_space": {"const": "rhwp_css_px_96dpi"},
    "render_key": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/textRenderKey"},
        {"$ref": "#/$defs/visualRenderKey"}
      ]
    },
    "text": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
    "linked_block_id": {
      "type": ["string", "null"],
      "pattern": "^block_[0-9a-f]{24}$"
    },
    "linked_image_occurrence_id": {
      "type": ["string", "null"],
      "pattern": "^occ_[0-9a-f]{24}$"
    },
    "preceding_text": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/textContext"}]
    },
    "link_method": {
      "enum": [
        "top_level_textline",
        "table_overlay_page_sequence_bbox_render_key_exact",
        "image_evidence_page_sequence_bbox_render_key_exact",
        "unlinked"
      ]
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "w": {"type": "number", "exclusiveMinimum": 0},
        "h": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "textRenderKey": {
      "type": "object",
      "required": ["section", "paragraph"],
      "properties": {
        "section": {"type": "integer", "minimum": 0},
        "paragraph": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "visualRenderKey": {
      "type": "object",
      "required": ["section", "paragraph", "control"],
      "properties": {
        "section": {"type": "integer", "minimum": 0},
        "paragraph": {"type": "integer", "minimum": 0},
        "control": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "textContext": {
      "type": "object",
      "required": ["text", "bbox", "render_key", "method"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 500},
        "bbox": {"$ref": "#/$defs/bbox"},
        "render_key": {"$ref": "#/$defs/textRenderKey"},
        "method": {"const": "nearest_prior_top_level_textline"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"node_type": {"const": "text"}}, "required": ["node_type"]},
      "then": {
        "properties": {
          "status": {"const": "render_text"},
          "render_key": {"$ref": "#/$defs/textRenderKey"},
          "text": {"type": "string", "minLength": 1, "maxLength": 500},
          "linked_block_id": {"type": "null"},
          "linked_image_occurrence_id": {"type": "null"},
          "preceding_text": {"type": "null"},
          "link_method": {"const": "top_level_textline"}
        }
      }
    },
    {
      "if": {"properties": {"node_type": {"const": "table"}}, "required": ["node_type"]},
      "then": {
        "properties": {
          "status": {"enum": ["verified_table_link", "render_only_unlinked"]},
          "render_key": {"$ref": "#/$defs/visualRenderKey"},
          "text": {"type": "null"},
          "linked_image_occurrence_id": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"node_type": {"const": "image"}}, "required": ["node_type"]},
      "then": {
        "properties": {
          "status": {"enum": ["verified_image_link", "render_only_unlinked"]},
          "render_key": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/visualRenderKey"}]},
          "text": {"type": "null"},
          "linked_block_id": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "verified_table_link"}}, "required": ["status"]},
      "then": {
        "properties": {
          "linked_block_id": {"type": "string"},
          "link_method": {"const": "table_overlay_page_sequence_bbox_render_key_exact"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "verified_image_link"}}, "required": ["status"]},
      "then": {
        "properties": {
          "linked_image_occurrence_id": {"type": "string"},
          "render_key": {"$ref": "#/$defs/visualRenderKey"},
          "link_method": {"const": "image_evidence_page_sequence_bbox_render_key_exact"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "render_only_unlinked"}}, "required": ["status"]},
      "then": {
        "properties": {
          "linked_block_id": {"type": "null"},
          "linked_image_occurrence_id": {"type": "null"},
          "link_method": {"const": "unlinked"}
        }
      }
    }
  ],
  "additionalProperties": false
}
