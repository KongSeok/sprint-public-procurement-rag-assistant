{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midprojectrag.local/schemas/catalog-response.schema.json",
  "title": "MidProjectRAG UI-safe catalog search response",
  "description": "Contains every local match. Evidence locators are deliberately absent from this public projection.",
  "type": "object",
  "required": ["schema_version", "total_count", "documents"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "total_count": {"type": "integer", "minimum": 0},
    "documents": {
      "type": "array",
      "items": {"$ref": "#/$defs/documentCard"}
    }
  },
  "$defs": {
    "documentId": {
      "type": "string",
      "pattern": "^doc_[0-9a-f]{24}$"
    },
    "evidenceClass": {
      "type": "object",
      "required": ["source_type"],
      "properties": {
        "source_type": {
          "enum": [
            "official_web",
            "official_attachment",
            "local_source_block",
            "secondary_web",
            "local_audit",
            "catalog_record"
          ]
        }
      },
      "additionalProperties": false
    },
    "metadataFact": {
      "type": "object",
      "required": [
        "fact_id",
        "doc_id",
        "field",
        "value",
        "normalized_value",
        "value_type",
        "state",
        "decision",
        "reason_code",
        "confidence",
        "correction_id",
        "checked_at",
        "evidence"
      ],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^fact_[0-9a-f]{24}$"},
        "doc_id": {"$ref": "#/$defs/documentId"},
        "field": {
          "enum": [
            "notice_id_namespace",
            "notice_number",
            "notice_round",
            "project_name",
            "project_amount_raw",
            "ordering_agency",
            "published_at",
            "bid_start_at",
            "bid_end_at",
            "bid_open_at",
            "proposal_evaluation_at",
            "source_format"
          ]
        },
        "value": {"type": ["string", "null"], "maxLength": 30000},
        "normalized_value": {"type": ["string", "null"], "maxLength": 30000},
        "value_type": {"enum": ["text", "krw_amount", "kst_datetime", "source_format"]},
        "state": {
          "enum": [
            "confirmed",
            "source_recorded",
            "source_not_stated",
            "not_applicable",
            "unverified",
            "not_finalized",
            "undisclosed",
            "semantic_mismatch",
            "suspect_sentinel",
            "unknown"
          ]
        },
        "decision": {
          "oneOf": [
            {"enum": ["apply", "clear", "retain_null"]},
            {"type": "null"}
          ]
        },
        "reason_code": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
            {"type": "null"}
          ]
        },
        "confidence": {
          "oneOf": [
            {"enum": ["high", "medium", "low"]},
            {"type": "null"}
          ]
        },
        "correction_id": {
          "oneOf": [
            {"type": "string", "pattern": "^corr_[a-z0-9_]{1,64}$"},
            {"type": "null"}
          ]
        },
        "checked_at": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/evidenceClass"}
        }
      },
      "additionalProperties": false
    },
    "documentCard": {
      "type": "object",
      "required": ["doc_id", "facts"],
      "properties": {
        "doc_id": {"$ref": "#/$defs/documentId"},
        "facts": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/metadataFact"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
