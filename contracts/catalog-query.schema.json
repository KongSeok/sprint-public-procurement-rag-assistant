{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midprojectrag.local/schemas/catalog-query.schema.json",
  "title": "MidProjectRAG local catalog filter",
  "description": "All supplied filters are combined with logical AND. Reversed date or amount ranges are rejected by the typed runtime validator.",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "notice_id_namespace": {"$ref": "#/$defs/exactText128"},
    "notice_number": {"$ref": "#/$defs/exactText128"},
    "notice_round": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^\\r\\n]+$"},
        {"type": "null"}
      ]
    },
    "agency": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$"},
        {"type": "null"}
      ]
    },
    "amount_min_krw": {"type": ["integer", "null"], "minimum": 0},
    "amount_max_krw": {"type": ["integer", "null"], "minimum": 0},
    "bid_end_from": {"$ref": "#/$defs/calendarDate"},
    "bid_end_to": {"$ref": "#/$defs/calendarDate"},
    "source_formats": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[^\\r\\n]+$"
      },
      "uniqueItems": true
    },
    "text": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n]+$"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "exactText128": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\r\\n]+$"},
        {"type": "null"}
      ]
    },
    "calendarDate": {
      "oneOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {"type": "null"}
      ]
    }
  },
  "additionalProperties": false
}
