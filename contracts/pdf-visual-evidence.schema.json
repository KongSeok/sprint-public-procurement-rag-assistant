{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midprojectrag.local/schemas/pdf-visual-evidence.schema.json",
  "title": "Local PDF table and image detection candidates",
  "description": "Each row is a geometry/detection candidate; aggregate counts are not verified semantic object counts.",
  "type": "object",
  "required": [
    "schema_version", "record_id", "doc_id", "page", "sequence_in_page",
    "node_type", "status", "bbox", "page_bbox", "coordinate_space",
    "method", "source_sha256", "content_sha256", "preceding_text", "content"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_id": {"type": "string", "pattern": "^pdfvis_[0-9a-f]{24}$"},
    "doc_id": {"type": "string", "pattern": "^doc_[0-9a-f]{24}$"},
    "page": {"type": "integer", "minimum": 1},
    "sequence_in_page": {"type": "integer", "minimum": 0},
    "node_type": {"enum": ["table", "image"]},
    "status": {"enum": ["line_table_candidate", "image_geometry_candidate"]},
    "bbox": {"$ref": "#/$defs/bbox"},
    "page_bbox": {"$ref": "#/$defs/bbox"},
    "coordinate_space": {"const": "pdf_points_top_left"},
    "method": {"const": "pdfplumber_lines_v1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preceding_text": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/textContext"}
      ]
    },
    "content": {
      "oneOf": [
        {"$ref": "#/$defs/tableContent"},
        {"$ref": "#/$defs/imageContent"}
      ]
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "w": {"type": "number", "exclusiveMinimum": 0},
        "h": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "textContext": {
      "type": "object",
      "required": ["text", "text_sha256", "bbox", "method"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 10000},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "method": {"const": "nearest_prior_same_page_textline_outside_tables"}
      },
      "additionalProperties": false
    },
    "rawColor": {
      "oneOf": [
        {"type": "null"},
        {"type": "number"},
        {"type": "string", "minLength": 1, "maxLength": 64},
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "number"}
        }
      ]
    },
    "fillEvidence": {
      "type": "object",
      "required": ["bbox", "fill_present", "raw_non_stroking_color"],
      "properties": {
        "bbox": {"$ref": "#/$defs/bbox"},
        "fill_present": {"const": true},
        "raw_non_stroking_color": {"$ref": "#/$defs/rawColor"}
      },
      "additionalProperties": false
    },
    "cell": {"type": ["string", "null"]},
    "tableContent": {
      "type": "object",
      "required": [
        "kind", "rows", "cols", "cell_count", "matrix", "matrix_sha256",
        "direct_fill_evidence"
      ],
      "properties": {
        "kind": {"const": "table_cell_matrix"},
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1},
        "cell_count": {"type": "integer", "minimum": 1},
        "matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/cell"}
          }
        },
        "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "direct_fill_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/fillEvidence"}
        }
      },
      "additionalProperties": false
    },
    "imageContent": {
      "type": "object",
      "required": ["kind", "image_signature_sha256"],
      "properties": {
        "kind": {"const": "image_geometry"},
        "image_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"node_type": {"const": "table"}}, "required": ["node_type"]},
      "then": {
        "properties": {
          "status": {"const": "line_table_candidate"},
          "content": {"$ref": "#/$defs/tableContent"}
        }
      }
    },
    {
      "if": {"properties": {"node_type": {"const": "image"}}, "required": ["node_type"]},
      "then": {
        "properties": {
          "status": {"const": "image_geometry_candidate"},
          "content": {"$ref": "#/$defs/imageContent"}
        }
      }
    }
  ],
  "additionalProperties": false
}
