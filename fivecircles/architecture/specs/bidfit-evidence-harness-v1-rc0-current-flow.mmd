flowchart TD
    Q["Current application query"] --> RP["Legacy application retrieval"]
    RP --> GEN["Current local or API generator"]
    GEN --> CIT["Legacy citation / response"]
    NQ["New RuntimeRequest"] --> DTO["Frozen allowlist + ResolvedScope"]
    DTO --> PLAN_GAP["QueryPlan / E1 bounded loop: next GAP"]
    DTO --> STORE["Immutable EvidenceStore"]
    STORE --> CHILD["9,496 extractive child evidence"]
    STORE --> PAGE["9,331 legacy page evidence"]
    CHILD --> KURE["KURE-v1 1,024d child dense"]
    CHILD --> KIWI["Kiwi 0.23.2 BM25 child"]
    KURE --> RRF["RRF k=60 / independent budgets"]
    KIWI --> RRF
    RRF --> SEL["Coverage + bounded parent context"]
    PAGE --> CONTROL["Legacy page control adapter"]
    SEL -. "not yet wired to generator" .-> PLAN_GAP
    CONTROL -. "A/B control" .-> PLAN_GAP
    SAVED["129 saved answers"] --> SCORE["Provider-free deterministic scorer"]
    SCORE --> OUT["Private replay receipt"]

    class DTO,STORE,CHILD,PAGE,KURE,KIWI,RRF,SEL,CONTROL,SCORE,OUT green
    class GEN blue
    class Q,NQ,SAVED gray
    class PLAN_GAP red
    class RP,CIT amber

    classDef green fill:#e8f2ea,stroke:#bdd1c2,color:#1f2933,stroke-width:1.5px
    classDef blue fill:#e8f0f7,stroke:#c2d3e0,color:#1f2933,stroke-width:1.5px
    classDef amber fill:#fff4dc,stroke:#e7c88f,color:#1f2933,stroke-width:1.5px
    classDef red fill:#fde9e6,stroke:#e8bab5,color:#1f2933,stroke-width:1.5px
    classDef gray fill:#eef1ed,stroke:#d8e0da,color:#1f2933,stroke-width:1.5px
