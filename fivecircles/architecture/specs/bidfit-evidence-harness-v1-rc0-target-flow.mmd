flowchart TD
    Q["Query + history"] --> G["Runtime integrity gate"]
    G --> P["Deterministic QueryPlan"]
    P --> B["Belief / Progress"]
    B --> R{"Typed specialist route"}
    R -->|"fact / compare / follow-up"| D["KURE child dense"]
    R -->|"fact / compare / follow-up"| L["Kiwi BM25 child"]
    D --> U["Independent candidate union"]
    L --> U
    U --> F["RRF k=60"]
    F --> RR["Identity or optional Qwen reranker"]
    RR --> C["Document / slot coverage"]
    C --> H["Bounded typed action loop"]
    R -->|"analytics"| A["Deterministic analytics"]
    R -->|"exhaustive list"| E["Document predicate + completeness"]
    R -->|"table / visual"| V["Text-first object bridge / explicit unavailable"]
    A --> VP["Verified evidence pack"]
    E --> VP
    V --> VP
    H --> VP
    VP --> GEN["Configurable local / API generator"]
    GEN --> SC["Structured claims + citations"]
    SC --> EV["Layered offline evaluation + private trace"]

