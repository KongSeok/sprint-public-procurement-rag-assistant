flowchart TD
 Q["Query + history"] --> D["Default legacy route"]
 D --> R["Existing page dense top-10"]
 R --> C["Top-5 context"]
 C --> G["Existing generator + citations"]
 G --> T["Existing baseline run record"]
 Q -. "explicit opt-in" .-> P["Query plan / typed policy"]
 P -->|fact / compare / followup| H["Bounded harness state/actions"]
 P -->|list| L["Scoped full scan + document reduce"]
 H --> X["KURE legacy PAGE + CHILD BM25 / RRF"]
 X --> V["Verifier + targeted bridge"]
 V -->|complete| CP["Verified context pack"]
 CP --> GA["Evidence Generator adapter"]
 GA --> TT["Private v2 trace / config seal"]
 L -->|all documents decided| CP
 L -->|unknown / budget / incomplete| AB
 V -->|missing and budget remains| H
 V -->|unresolved / contradiction / budget| AB["Bounded abstention"]
 E["Validated page/table/visual artifacts"] --> R
 E --> X
 VM["Multimodal embedding / learned policy"] -. "capability gap" .-> X
 VM -. "not promoted" .-> P
 classDef green fill:#e8f2ea,stroke:#bdd1c2,color:#1f2933
 classDef blue fill:#e8f0f7,stroke:#c2d3e0,color:#1f2933
 classDef red fill:#fde9e6,stroke:#e8bab5,color:#1f2933
 classDef amber fill:#fff4d9,stroke:#cfa13b,color:#1f2933
 classDef gray fill:#eeeeee,stroke:#aaaaaa,color:#1f2933
 class Q,R,C,T,E green
 class D,G blue
 class P,H,X,V,CP,GA,TT,L amber
 class AB red
 class VM gray
